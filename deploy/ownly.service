[Unit]
Description=Ownly (gunicorn)
After=network.target

[Service]
User=ownly
Group=ownly
WorkingDirectory=/srv/ownly
Environment=OWNLY_INSTANCE=/var/lib/ownly OWNLY_HTTPS=1 OWNLY_PROXIES=1 PYTHONDONTWRITEBYTECODE=1
# One process keeps one copy of the model in memory; threads handle concurrent requests.
ExecStart=/srv/ownly/.venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8000 --timeout 60 \
  --no-control-socket --access-logfile - "ownly:create_app()"
Restart=on-failure
RestartSec=3

# The app may only write to its data folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ownly
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
